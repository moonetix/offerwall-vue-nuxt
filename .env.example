# Copy to .env and fill in. Never commit .env.
# A built Nuxt server does not read .env by itself: npm start loads it with --env-file-if-exists.
# On your host, set these as real environment variables.

# Moonetix dashboard: Offerwalls, your offerwall, Integration
MOONETIX_APP_ID=your-app-id
MOONETIX_LINK_SALT=your-link-hash-salt
# Moonetix dashboard: Postback page
MOONETIX_POSTBACK_KEY=your-postback-secret-key

# Seals the demo session cookie. At least 32 random characters.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional
PORT=3000
DATABASE_PATH=./data/app.sqlite
